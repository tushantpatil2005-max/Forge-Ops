def planner_agent(state: OpsState) -> dict:
    """Decompose the objective and delegate tasks to specialist agents."""
    objective = state["objective"].strip()
    memory = dict(state.get("shared_memory") or {})
    memory["objective"] = objective
    memory["planner_version"] = 1

    # Simple domain tagging drives which research queries are delegated
    lower = objective.lower()
    tasks: list[TaskItem] = [
        {
            "id": "t_research_market",
            "title": "Research market signals related to the objective",
            "owner": "researcher",
            "status": "delegated",
            "notes": objective,
        },
        {
            "id": "t_research_product",
            "title": "Collect product / MVP guidance",
            "owner": "researcher",
            "status": "delegated",
            "notes": "mvp operations activation",
        },
        {
            "id": "t_analyze",
            "title": "Analyze findings and recommend a direction",
            "owner": "analyst",
            "status": "delegated",
            "notes": "",
        },
        {
            "id": "t_execute",
            "title": "Produce an actionable execution plan",
            "owner": "execution",
            "status": "delegated",
            "notes": "",
        },
    ]
    if any(w in lower for w in ("hire", "hiring", "recruit", "headcount")):
        tasks.insert(
            2,
            {
                "id": "t_research_hiring",
                "title": "Research hiring velocity constraints",
                "owner": "researcher",
                "status": "delegated",
                "notes": "hiring platform roles",
            },
        )
    tasks = tasks[:MAX_TASKS]
    memory["delegated_task_ids"] = [t["id"] for t in tasks]

    return {
        "tasks": tasks,
        "shared_memory": memory,
        "status": "running",
        "approval_status": "pending",
        "messages": [
            _msg(
                "planner",
                "researcher",
                "delegation",
                f"Delegated {sum(1 for t in tasks if t['owner']=='researcher')} research tasks for: {objective}",
            ),
            _msg(
                "planner",
                "analyst",
                "delegation",
                "Analyze researcher outputs once findings are on the shared board.",
            ),
            _msg(
                "planner",
                "execution",
                "delegation",
                "Draft a dated execution plan after analysis lands.",
            ),
        ],
        "trace": [
            _trace("planner", "plan", f"Created {len(tasks)} tasks for objective."),
            _trace("planner", "delegate", "Handed work to researcher, analyst, and execution."),
        ],
    }


def researcher_agent(state: OpsState) -> dict:
    """Run tools for each research task and publish findings to shared memory."""
    findings: list[dict] = list(state.get("research_findings") or [])
    memory = dict(state.get("shared_memory") or {})
    msgs: list[AgentMessage] = []
    traces: list[TraceEvent] = []
    tasks = [dict(t) for t in state.get("tasks") or []]

    for task in tasks:
        if task["owner"] != "researcher" or task["status"] == "done":
            continue
        query = f"{state['objective']} {task['notes']} {task['title']}"
        market = tool_market_search(query, k=2)
        product = tool_product_lookup(query, k=2)
        for hit in market + product:
            findings.append(
                {
                    "task_id": task["id"],
                    "source_id": hit["id"],
                    "title": hit["title"],
                    "text": hit["text"],
                    "score": hit.get("score", 0),
                }
            )
        task["status"] = "done"
        traces.append(
            _trace(
                "researcher",
                "tool_call",
                f"{task['id']}: market={len(market)} product={len(product)} hits",
            )
        )

    # Deduplicate by source_id
    seen = set()
    unique = []
    for f in findings:
        if f["source_id"] in seen:
            continue
        seen.add(f["source_id"])
        unique.append(f)
    findings = unique

    memory["research_count"] = len(findings)
    memory["research_ids"] = [f["source_id"] for f in findings]
    msgs.append(
        _msg(
            "researcher",
            "analyst",
            "handoff",
            f"Published {len(findings)} findings on the shared board.",
        )
    )
    traces.append(_trace("researcher", "handoff", "Notified analyst via message bus."))

    return {
        "tasks": tasks,
        "research_findings": findings,
        "shared_memory": memory,
        "messages": msgs,
        "trace": traces,
    }


def analyst_agent(state: OpsState) -> dict:
    """Score options from research and write a recommendation into shared memory."""
    findings = state.get("research_findings") or []
    objective = state["objective"]
    memory = dict(state.get("shared_memory") or {})
    tasks = [dict(t) for t in state.get("tasks") or []]

    # Derive simple option scores from finding coverage
    themes = {
        "mvp_focus": 0.0,
        "market_fit": 0.0,
        "hiring_support": 0.0,
        "pricing_signal": 0.0,
    }
    for f in findings:
        text = (f.get("title", "") + " " + f.get("text", "")).lower()
        if "mvp" in text or "activation" in text:
            themes["mvp_focus"] += 1.2
        if "smb" in text or "demand" in text or "saas" in text:
            themes["market_fit"] += 1.0
        if "hiring" in text or "contractor" in text:
            themes["hiring_support"] += 1.0
        if "pricing" in text or "tier" in text:
            themes["pricing_signal"] += 1.0

    ranked_themes = sorted(themes.items(), key=lambda kv: kv[1], reverse=True)
    top = ranked_themes[0][0] if ranked_themes and ranked_themes[0][1] > 0 else "mvp_focus"

    recommendation = {
        "direction": top,
        "confidence": round(min(0.95, 0.45 + 0.1 * len(findings) + 0.05 * themes[top]), 2),
        "theme_scores": {k: round(v, 2) for k, v in ranked_themes},
        "rationale": strip_machine_labels(
            f"Based on {len(findings)} sources, the strongest signal is '{top.replace('_', ' ')}' "
            f"for objective: {objective}."
        ),
        "risks": [
            "Evidence is drawn from a limited internal corpus; validate with customer interviews.",
            "Hiring timelines may slip if contractor coverage is delayed.",
        ],
        "source_ids": [f["source_id"] for f in findings],
    }

    for task in tasks:
        if task["owner"] == "analyst":
            task["status"] = "done"

    memory["analysis_direction"] = top
    memory["analysis_confidence"] = recommendation["confidence"]

    return {
        "tasks": tasks,
        "analysis": recommendation,
        "shared_memory": memory,
        "messages": [
            _msg(
                "analyst",
                "execution",
                "handoff",
                f"Recommendation ready: {top} (confidence {recommendation['confidence']}).",
            )
        ],
        "trace": [
            _trace("analyst", "score", f"Theme scores: {recommendation['theme_scores']}"),
            _trace("analyst", "recommend", recommendation["rationale"]),
        ],
    }


