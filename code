def tool_market_search(query: str, k: int = 3) -> list[dict]:
    q = tokens(query)
    ranked = []
    for doc in MARKET_NOTES:
        score = sum(1 for t in q if t in (doc["topic"] + " " + doc["text"]).lower())
        if score:
            ranked.append({**doc, "score": score})
    ranked.sort(key=lambda d: d["score"], reverse=True)
    return [{k: d[k] for k in ("id", "title", "text", "score")} for d in ranked[:k]]


def tool_product_lookup(query: str, k: int = 2) -> list[dict]:
    q = tokens(query)
    ranked = []
    for doc in PRODUCT_NOTES:
        score = sum(1 for t in q if t in (doc["topic"] + " " + doc["text"]).lower())
        if score or not q:
            ranked.append({**doc, "score": score or 0.1})
    ranked.sort(key=lambda d: d["score"], reverse=True)
    return [{k: d[k] for k in ("id", "title", "text", "score")} for d in ranked[:k]]


# ---------------------------------------------------------------------------
# Shared graph state
# ---------------------------------------------------------------------------


class AgentMessage(TypedDict):
    from_agent: str
    to_agent: str
    type: str
    body: str
    at_ms: float


class TraceEvent(TypedDict):
    agent: str
    event: str
    detail: str
    at_ms: float


class TaskItem(TypedDict):
    id: str
    title: str
    owner: str
    status: str
    notes: str


class OpsState(TypedDict):
    objective: str
    thread_id: str
    tasks: list[TaskItem]
    research_findings: list[dict]
    analysis: dict
    execution_plan: dict
    shared_memory: dict
    messages: Annotated[list[AgentMessage], operator.add]
    trace: Annotated[list[TraceEvent], operator.add]
    approval_status: str  # pending | approved | rejected | not_required
    approval_note: str
    status: str  # running | awaiting_approval | complete | rejected
    final_report: str


def _msg(frm: str, to: str, type_: str, body: str) -> AgentMessage:
    return {
        "from_agent": frm,
        "to_agent": to,
        "type": type_,
        "body": strip_machine_labels(body),
        "at_ms": now_ms(),
    }


def _trace(agent: str, event: str, detail: str) -> TraceEvent:
    return {
        "agent": agent,
        "event": event,
        "detail": strip_machine_labels(detail),
        "at_ms": now_ms(),
    }


