# Self-check
# ---------------------------------------------------------------------------


def self_check() -> list[str]:
    notes: list[str] = []
    system = StartupOpsSystem()
    assert len(system.list_agents()) >= 4

    objective = (
        "Launch an SMB ops SaaS MVP with usage-based pricing and a contractor bridge for hiring"
    )
    result = system.start(objective)
    notes.append(f"status={result['status']} interrupted={result['interrupted']}")
    assert result["status"] == "awaiting_approval"
    assert result["interrupted"] is True
    assert "human_approval" in result["next_nodes"]

    # Four agents participated in the trace
    agents_in_trace = {t["agent"] for t in result["trace"]}
    for name in ("planner", "researcher", "analyst", "execution"):
        assert name in agents_in_trace, f"missing {name} in trace"
    notes.append(f"trace_agents={sorted(agents_in_trace)}")

    # Task delegation
    owners = {t["owner"] for t in result["tasks"]}
    assert "researcher" in owners and "analyst" in owners and "execution" in owners
    notes.append(f"delegated_owners={sorted(owners)}")

    # Shared memory populated
    mem = result["shared_memory"]
    assert mem.get("objective")
    assert mem.get("research_count", 0) >= 1
    assert mem.get("analysis_direction")
    notes.append(f"memory_keys={sorted(mem.keys())}")

    # Agent-to-agent messages
    assert any(m["from_agent"] == "planner" for m in result["messages"])
    assert any(m["from_agent"] == "researcher" and m["to_agent"] == "analyst" for m in result["messages"])
    notes.append(f"messages={len(result['messages'])}")

    # Research + analysis + plan
    assert result["research_findings"]
    assert result["analysis"].get("direction")
    assert result["execution_plan"].get("workstreams")
    blob = json.dumps(result)
    assert not re.search(r"(?i)ai[- ]generated|powered by ai|as an ai", blob)

    # Persist + human approval
    thread_id = result["thread_id"]
    mid = system.snapshot(thread_id)
    assert mid["status"] == "awaiting_approval"
    assert mid["persisted"] is True

    approved = system.resume(thread_id, "approve", "Ship discovery this week.")
    assert approved["status"] == "complete"
    assert approved["approval_status"] == "approved"
    assert approved["execution_plan"]["status"] == "approved"
    assert not approved["interrupted"]
    notes.append(f"approved report={approved['final_report'][:80]}")

    # Second thread: reject path
    system2 = StartupOpsSystem()
    r2 = system2.start("Test pricing packaging only")
    rejected = system2.resume(r2["thread_id"], "reject", "Need more customer evidence.")
    assert rejected["status"] == "rejected"
    assert rejected["approval_status"] == "rejected"
    notes.append("reject path ok")

    return notes


