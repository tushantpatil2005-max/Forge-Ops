            raise HTTPException(status_code=400, detail=str(err)) from err

    @app.get("/ops/{thread_id}")
    def get_ops(thread_id: str):
        return _system.snapshot(thread_id)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(description="Multi-Agent Startup Operations System")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("-o", "--objective", type=str)
    parser.add_argument("--approve", metavar="THREAD_ID")
    parser.add_argument("--reject", metavar="THREAD_ID")
    parser.add_argument("--note", default="")
    parser.add_argument("--serve", action="store_true")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8000)
    args = parser.parse_args()

    if args.check:
        notes = self_check()
        print("PASS")
        for n in notes:
            print(n)
        return

    if args.serve:
        if not HAS_FASTAPI:
            raise SystemExit("Install fastapi uvicorn: pip install fastapi uvicorn")
        import uvicorn

        uvicorn.run(app, host=args.host, port=args.port)
        return

    system = StartupOpsSystem()

    if args.approve:
        print(json.dumps(system.resume(args.approve, "approve", args.note), indent=2))
        return
    if args.reject:
        print(json.dumps(system.resume(args.reject, "reject", args.note), indent=2))
        return

    if not args.objective:
        parser.print_help()
        return

    result = system.start(args.objective)
    print(json.dumps(result, indent=2))
    if result.get("interrupted"):
        print(
            f"\nPaused for approval. Resume with:\n"
            f"  python startup_ops_system.py --approve {result['thread_id']} --note '…'\n"
            f"  python startup_ops_system.py --reject {result['thread_id']} --note '…'"
        )


if __name__ == "__main__":
    main()
