def strip_machine_labels(text: str) -> str:
    cleaned = re.sub(
        r"(?i)\s*[\(\[]?\s*(ai[- ]generated|generated by (ai|an? (ai|llm|model))|"
        r"as an ai[\w\s]*|powered by ai|created with (ai|chatgpt)|"
        r"this (plan|report|recommendation) was (automatically )?generated)\s*[\)\]]?\s*",
        " ",
        text,
    )
    return re.sub(r"\s{2,}", " ", cleaned).strip()


def now_ms() -> float:
    return time.time() * 1000


def tokens(text: str) -> list[str]:
    return [t for t in re.sub(r"[^a-z0-9]+", " ", text.lower()).split() if len(t) > 2]


