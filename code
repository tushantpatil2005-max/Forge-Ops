def human_approval_node(state: OpsState) -> dict:
    """
    LangGraph interrupt checkpoint. The graph pauses here until a human
    resumes with a Command(resume=...).
    """
    plan = state.get("execution_plan") or {}
    payload = {
        "question": "Approve this execution plan?",
        "objective": state.get("objective"),
        "direction": plan.get("direction"),
        "workstreams": [w.get("name") for w in plan.get("workstreams") or []],
        "confidence": plan.get("confidence"),
    }
    # interrupt() pauses the graph and surfaces `payload` to the caller
    decision = interrupt(payload)

    # Expected resume value: {"action": "approve"|"reject", "note": str}
    if not isinstance(decision, dict):
        decision = {"action": str(decision), "note": ""}

    action = (decision.get("action") or "reject").lower().strip()
    note = strip_machine_labels(decision.get("note") or "")
    memory = dict(state.get("shared_memory") or {})
    plan = dict(plan)

    if action == "approve":
        plan["status"] = "approved"
        memory["plan_status"] = "approved"
        status = "complete"
        approval_status = "approved"
        report = strip_machine_labels(
            f"Approved execution plan for '{state['objective']}'. "
            f"Workstreams: {', '.join(memory.get('execution_workstreams') or [])}. {note}".strip()
        )
        event = "approved"
    else:
        plan["status"] = "rejected"
        memory["plan_status"] = "rejected"
        status = "rejected"
        approval_status = "rejected"
        report = strip_machine_labels(
            f"Plan rejected for '{state['objective']}'. {note or 'No note provided.'}"
        )
        event = "rejected"

    return {
        "execution_plan": plan,
        "shared_memory": memory,
        "status": status,
        "approval_status": approval_status,
        "approval_note": note,
        "final_report": report,
        "messages": [_msg("human", "execution", event, report)],
        "trace": [_trace("human", event, report)],
    }


# ---------------------------------------------------------------------------
# Build LangGraph app
# ---------------------------------------------------------------------------


def build_graph(checkpointer: Optional[MemorySaver] = None):
    graph = StateGraph(OpsState)
    graph.add_node("planner", planner_agent)
    graph.add_node("researcher", researcher_agent)
    graph.add_node("analyst", analyst_agent)
    graph.add_node("execution", execution_agent)
    graph.add_node("human_approval", human_approval_node)

    graph.add_edge(START, "planner")
    graph.add_edge("planner", "researcher")
    graph.add_edge("researcher", "analyst")
    graph.add_edge("analyst", "execution")
    graph.add_edge("execution", "human_approval")
    graph.add_edge("human_approval", END)

    return graph.compile(checkpointer=checkpointer or MemorySaver())


class StartupOpsSystem:
    """Facade around the compiled LangGraph app with persistence helpers."""

    def __init__(self):
        self.checkpointer = MemorySaver()
        self.app = build_graph(self.checkpointer)

    def start(self, objective: str, thread_id: Optional[str] = None) -> dict:
        thread_id = thread_id or f"thread_{uuid.uuid4().hex[:10]}"
        config = {"configurable": {"thread_id": thread_id}}
        initial: OpsState = {
            "objective": objective.strip(),
            "thread_id": thread_id,
            "tasks": [],
            "research_findings": [],
            "analysis": {},
            "execution_plan": {},
            "shared_memory": {},
            "messages": [],
            "trace": [],
            "approval_status": "pending",
            "approval_note": "",
            "status": "running",
            "final_report": "",
        }
        # Stream until interrupt or end
        for _ in self.app.stream(initial, config, stream_mode="values"):
            pass
        return self.snapshot(thread_id)

    def resume(self, thread_id: str, action: str, note: str = "") -> dict:
        config = {"configurable": {"thread_id": thread_id}}
        self.app.invoke(
            Command(resume={"action": action, "note": note}),
            config,
        )
        return self.snapshot(thread_id)

    def snapshot(self, thread_id: str) -> dict:
        config = {"configurable": {"thread_id": thread_id}}
        snap = self.app.get_state(config)
        values = dict(snap.values or {})
        interrupted = bool(snap.next)
        return {
            "thread_id": thread_id,
            "status": values.get("status", "unknown"),
            "objective": values.get("objective", ""),
            "tasks": values.get("tasks", []),
            "research_findings": values.get("research_findings", []),
            "analysis": values.get("analysis", {}),
            "execution_plan": values.get("execution_plan", {}),
            "shared_memory": values.get("shared_memory", {}),
            "messages": values.get("messages", []),
            "trace": values.get("trace", []),
            "approval_status": values.get("approval_status", ""),
            "approval_note": values.get("approval_note", ""),
            "final_report": values.get("final_report", ""),
            "interrupted": interrupted,
            "next_nodes": list(snap.next or []),
            "persisted": True,
        }

    def list_agents(self) -> list[str]:
        return ["planner", "researcher", "analyst", "execution", "human_approval"]


